//改二进制某一位为1，随后在换回来
int main()
{
	int n = 13;
	int k = 5;
	n |= (1 << (k - 1));
	//00000000000000000000000000001101
	//00000000000000000000000000010000
	//00000000000000000000000000011101
	printf("%d\n", n);  //29

	n &= ~(1 << (k - 1));
	printf("%d\n", n); //13
	return 0;
}
